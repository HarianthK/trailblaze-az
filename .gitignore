# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pipeline build inputs — large and re-fetchable, unlike the artifacts in
# pipeline/data, which are small and versioned on purpose
/pipeline/extract/

# The attribute table is ~931k rows. Its summary stamp is committed instead:
# a diff of a million CSV lines tells you nothing a distribution doesn't.
/pipeline/data/attributes.csv.gz
